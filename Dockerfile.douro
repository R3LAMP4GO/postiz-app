# syntax=docker/dockerfile:1
FROM node:22.20-bookworm-slim

ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION} \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:${PATH}

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash \
      g++ \
      make \
      nginx \
      python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx \
 && npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/commands/package.json apps/commands/package.json
COPY apps/extension/package.json apps/extension/package.json
COPY apps/frontend/package.json apps/frontend/package.json
COPY apps/orchestrator/package.json apps/orchestrator/package.json
COPY apps/sdk/package.json apps/sdk/package.json

RUN pnpm fetch --frozen-lockfile

COPY . .
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN pnpm install --frozen-lockfile \
 && NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

CMD ["sh", "-c", "nginx && pnpm run pm2"]
